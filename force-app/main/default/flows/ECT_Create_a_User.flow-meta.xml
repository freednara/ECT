    <decisions>
        <name>Enough_Licenses</name>
        <label>Enough Licenses?</label>
        <locationX>677</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Available_Licenses</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AvailableLicenseCountFormula</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Find_User_with_Username</targetReference>
            </connector>
            <label>Available Licenses</label>
        </rules>
        <rules>
            <name>No_Licenses</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AvailableLicenseCountFormula</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Out_of_Licenses</targetReference>
            </connector>
            <label>No Licenses</label>
        </rules>
    </decisions>
